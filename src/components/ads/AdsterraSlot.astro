---
/**
 * AdsterraSlot — an Adsterra ad unit mounted in a sandboxed iframe.
 *
 * Adsterra banner scripts all configure themselves through the shared
 * `window.atOptions` global, so two units inlined on one page clobber each
 * other (slot B renders with slot A's config). Every unit therefore lives in
 * its own static html file under `public/ads/` — `<name>.html`, holding
 * exactly the snippet from the Adsterra dashboard (Ad Units → GET CODE) —
 * and this component mounts it in an iframe. The sandbox omits
 * `allow-top-navigation` (some mobile creatives try to navigate the whole
 * page away) — but with `allow-scripts` + `allow-same-origin` both present
 * (creatives need them to render), the sandbox is layout containment and
 * navigation friction, NOT a hard security boundary against a malicious
 * creative; true isolation would take a separate origin. Full rationale:
 * docs/ads.md 「广告位怎么挂（独立文件 + iframe 隔离）」.
 *
 * Gated on PUBLIC_ADSTERRA_SLOT_<NAME> (name upper-cased, hyphens become
 * underscores — `sidebar-300x250` → `PUBLIC_ADSTERRA_SLOT_SIDEBAR_300X250`).
 * Empty = nothing rendered, the same env contract as the AdSense slots. The
 * html file itself is not build inputs — also create it in `public/ads/` or
 * the iframe 404s as an empty box.
 *
 * Configured ads load automatically once their original dimensions fit a
 * visible container. data-src defers layout-ineligible alternatives, not
 * consent. Responsive Native uses its rendered content height.
 */
interface Props {
  /** Slot name = html filename stem under public/ads/ (e.g. `sidebar-300x250`). */
  name: string;
  /** Creative width in px — keep in sync with the unit's Adsterra size. */
  width: number;
  /** Creative height in px — keep in sync with the unit's Adsterra size. */
  height: number;
  /** Set to `false` to hide the "Advertisement" label (labels default on). */
  label?: boolean;
  /**
   * Hide below md (fixed-size creatives clip inside a narrower iframe —
   * a 728 creative in a ~375px viewport shows ~47% and an inner scrollbar).
   * Pair a hideOnMobile banner with the responsive native-banner, which
   * fills any width. Same pattern as StickyBanner's `hidden md:block`.
   */
  hideOnMobile?: boolean;
  /** Hide this alternative when the content column is wider than this value. */
  maxContainerWidth?: number;
  /** Native units adapt to their container and use their rendered content height. */
  responsive?: boolean;
  /** Tight spacing for the shared top sticky unit. */
  compact?: boolean;
}

import { currentSharedStrings } from '~/lib/shared-ui';
import { ADSTERRA_KEYS } from '~/config/advertising';

const { name, width, height, label = true, hideOnMobile = false, maxContainerWidth, responsive = false, compact = false } = Astro.props;
const show = Boolean(ADSTERRA_KEYS[name]);
const iframeSrc = `/ads/${name}.html`;
const sharedStrings = currentSharedStrings(Astro.currentLocale);
const adLabel = sharedStrings.adLabel ?? 'Advertisement';
---
{
  show && (
    <>
      <div
        data-adsterra-slot={name}
        data-adsterra-min-width={responsive ? 0 : width}
        data-adsterra-max-width={maxContainerWidth}
        style="display:none"
        class:list={[
          compact ? 'flex-col items-center justify-center' : 'my-8 flex-col items-center justify-center',
          hideOnMobile ? 'hidden md:flex' : 'flex',
        ]}
      >
        {label && (
          <span class="mb-1 text-[10px] uppercase tracking-wider text-muted-foreground">{adLabel}</span>
        )}
        <iframe
          data-src={iframeSrc}
          data-adsterra-defer="1"
          data-adsterra-responsive={responsive ? '1' : undefined}
          style={responsive ? `width:100%;max-width:${width}px;height:${height}px;border:0` : `width:${width}px;height:${height}px;border:0`}
          loading="lazy"
          sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
          title={adLabel}
        />
      </div>
      {show && (
        <script is:inline>
          /* ES2018. Automatically load visible, fitting units; hidden alternatives
             remain deferred. Each slot is wired once across repeated scripts. */
          (function () {
            var wire = function () {
              var slots = document.querySelectorAll('[data-adsterra-slot]');
              for (var i = 0; i < slots.length; i++) {
                (function (slot) {
                  if (slot.getAttribute('data-adsterra-wired')) return;
                  slot.setAttribute('data-adsterra-wired', '1');
                  var frame = slot.querySelector('iframe');
                  var parent = slot.parentElement;
                  if (!frame || !parent) return;
                  var nativeHeight = function () {
                    if (!frame.getAttribute('data-adsterra-responsive')) return;
                    try {
                      var body = frame.contentDocument && frame.contentDocument.body;
                      if (!body) return;
                      var value = Math.ceil(body.getBoundingClientRect().height);
                      if (value > 0 && value < 6000) frame.style.height = value + 'px';
                    } catch (e) { /* keep the reserved size if unavailable */ }
                  };
                  frame.addEventListener('load', function () {
                    nativeHeight();
                    try {
                      var body = frame.contentDocument && frame.contentDocument.body;
                      if (body && window.ResizeObserver) new ResizeObserver(nativeHeight).observe(body);
                    } catch (e) { /* no observation available */ }
                  });
                  var update = function () {
                    var css = getComputedStyle(parent);
                    var available = parent.clientWidth - parseFloat(css.paddingLeft || '0') - parseFloat(css.paddingRight || '0');
                    var min = Number(slot.getAttribute('data-adsterra-min-width') || '0');
                    var max = Number(slot.getAttribute('data-adsterra-max-width') || 'Infinity');
                    var fits = available >= min && available <= max && parent.getClientRects().length > 0;
                    slot.style.display = fits ? '' : 'none';
                    if (!fits || slot.getBoundingClientRect().width < min || getComputedStyle(slot).display === 'none') {
                      // A resized-away unit must stop running while hidden.
                      // Preserve its own URL for a later genuine layout change.
                      var previousSrc = frame.getAttribute('src');
                      if (previousSrc) {
                        frame.setAttribute('data-src', previousSrc);
                        frame.setAttribute('data-adsterra-defer', '1');
                        frame.removeAttribute('src');
                      }
                      return;
                    }
                    var src = frame.getAttribute('data-src');
                    if (src) {
                      if (frame.getAttribute('data-adsterra-responsive')) frame.style.height = Math.round(Math.min(available, 1200) / 4) + 'px';
                      frame.src = src;
                      frame.removeAttribute('data-src');
                      frame.removeAttribute('data-adsterra-defer');
                    }
                    nativeHeight();
                  };
                  window.addEventListener('resize', update);
                  if (window.ResizeObserver) new ResizeObserver(update).observe(parent);
                  update();
                })(slots[i]);
              }
            };
            if (document.readyState === 'loading') {
              document.addEventListener('DOMContentLoaded', wire);
            } else {
              wire();
            }
          })();
        </script>
      )}
    </>
  )
}
